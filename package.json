{
    "name": "Veloz-Launcher",
    "productname": "Veloz Launcher",
    "version": "1.0.2",
    "description": "Launcher Veloz",
    "main": "src/app.js",
    "author": {
        "name": "luuxis, Issaw, Inc.",
        "email": "contact@luuxis.fr",
        "url": "https://github.com/luuxis"
    },
    "url": "http://issaw.srv-eh.net/launcher",
    "scripts": {
        "start": "cross-env-shell NODE_ENV=dev electron .",
        "dev": "cross-env-shell DEV_TOOL=open nodemon --exec npm start",
        "build": "node build.js --obf=true --build=platform",
        "icon": "node build.js --icon"
    },
    "license": "CCANC",
    "nodemonConfig": {
        "ext": "js,html,css",
        "ignore": "**/test"
    },
    "dependencies": {
